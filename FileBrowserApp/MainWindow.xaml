<Window x:Class="FileBrowserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FileBrowserApp.Controls"
        xmlns:conv="clr-namespace:FileBrowserApp.Converters"
        xmlns:models="clr-namespace:FileBrowserApp.Models"
        Title="File Browser" Height="720" Width="1180" MinHeight="480" MinWidth="800"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight makes the custom title bar row below draggable and double-click-to-maximize
             for free; GlassFrameThickness keeps the native drop shadow without a visible glass strip. -->
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                             CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:DateTimeConverter x:Key="DateTimeConverter" />
        <conv:CategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        <conv:PercentageConverter x:Key="PercentageConverter" />
        <conv:IsDirectoryToGlyphConverter x:Key="IsDirectoryToGlyphConverter" />
        <conv:WindowStateToGlyphConverter x:Key="WindowStateToGlyphConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: same background as the app, so it reads as one seamless surface
             instead of a separate native strip. The row itself is the WindowChrome caption
             (drag to move, double-click to maximize); only the buttons opt back into normal clicks. -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/icon-preview.png" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="File Browser" Margin="10,0,0,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource Aurora.CaptionButton}" Click="Minimize_Click" />
                <Button Style="{StaticResource Aurora.CaptionButton}" Click="MaximizeRestore_Click"
                        Content="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowStateToGlyphConverter}}" />
                <Button Content="&#xE8BB;" Style="{StaticResource Aurora.CaptionButton.Close}" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Home" Style="{StaticResource Aurora.PillButton}" Command="{Binding GoHomeCommand}" />
                <Button Content="Up" Style="{StaticResource Aurora.PillButton}" Command="{Binding NavigateUpCommand}" />
                <Button Content="Refresh" Style="{StaticResource Aurora.PillButton}" Command="{Binding RefreshCommand}" />
                <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush.Theme}"
                        BorderThickness="1" CornerRadius="14" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center" FontFamily="Consolas"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                </Border>
                <ProgressBar Style="{StaticResource Aurora.ProgressBar}" IsIndeterminate="True" Width="80" Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Main content: file listing + storage infographic -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="340" MinWidth="290" />
                </Grid.ColumnDefinitions>

                <!-- File browser -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush.Theme}" BorderThickness="1" CornerRadius="14"
                        ClipToBounds="True">
                    <DataGrid x:Name="FileGrid"
                              ItemsSource="{Binding Entries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              SelectionMode="Single"
                              MouseDoubleClick="FileGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:FileSystemEntry">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding IsDirectory, Converter={StaticResource IsDirectoryToGlyphConverter}}"
                                                       FontFamily="Segoe Fluent Icons" Margin="2,0,10,0"
                                                       Foreground="{StaticResource AccentTealBrush}" />
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAccessible}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Width="110"
                                                 Binding="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Modified" Width="150"
                                                 Binding="{Binding ModifiedUtc, Converter={StaticResource DateTimeConverter}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Storage infographic -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush.Theme}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Storage Breakdown" FontSize="17" FontWeight="SemiBold"
                                   Margin="0,0,0,3">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource Color.TextPrimary}" Offset="0" />
                                    <GradientStop Color="{StaticResource Color.AccentTeal}" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayPath}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />

                        <CheckBox DockPanel.Dock="Top" Content="Include subfolders (recursive scan)"
                                  Style="{StaticResource Aurora.ToggleSwitch}"
                                  IsChecked="{Binding IncludeSubfolders}" Margin="0,0,0,12" />

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Style="{StaticResource Aurora.ProgressBar}" IsIndeterminate="True" Width="60"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="Scanning..." Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <Button Content="Cancel" Style="{StaticResource Aurora.PillButton}"
                                    Command="{Binding CancelScanCommand}"
                                    Padding="10,3" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="12,10" CornerRadius="10"
                                Background="{StaticResource SurfaceElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource AccentTealBrush}" VerticalAlignment="Center"
                                           Text="{Binding TotalBytesInView, Converter={StaticResource FileSizeConverter}}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <controls:DonutChart Grid.Row="0" Height="210" Slices="{Binding CategoryTotals}">
                                <controls:DonutChart.Effect>
                                    <DropShadowEffect Color="{StaticResource Color.AccentTeal}" Opacity="0.25"
                                                       BlurRadius="28" ShadowDepth="0" />
                                </controls:DonutChart.Effect>
                            </controls:DonutChart>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding CategoryTotals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:CategoryTotal">
                                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="9"
                                                    Padding="10,7" Margin="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,10,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />

                                                    <TextBlock Grid.Column="2" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11.5" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource PercentageConverter}">
                                                                <Binding Path="TotalBytes" />
                                                                <Binding Path="DataContext.TotalBytesInView" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="12.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                               Text="{Binding TotalBytes, Converter={StaticResource FileSizeConverter}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8" Background="#332B1F" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}" FontSize="12" />
            </Border>
        </Grid>
    </Grid>
</Window>
